# Настройки отправки SEO-страниц на хостинг. Скопируйте в sync.env и заполните.
# sync.env содержит пароль: права 600, в git не попадает (см. .gitignore).

# Как отправлять: lftp (FTP/FTPS/SFTP, подходит почти любому хостингу),
# rsync (нужен SSH-доступ к хостингу) или local (для тестов).
SYNC_METHOD=lftp

# --- lftp ---
SYNC_HOST=ftp.example-hosting.ru
SYNC_USER=u1234567
SYNC_PASSWORD=замените_на_пароль
# ftp (по умолчанию, с шифрованием если сервер умеет), ftps или sftp
SYNC_PROTOCOL=ftp
# SYNC_PORT=21
# Корень сайта на хостинге, относительно входа по FTP. Уточните в панели хостинга.
SYNC_REMOTE_ROOT=/www/primcom.ru

# --- rsync (вместо lftp) ---
# SYNC_METHOD=rsync
# SYNC_HOST=primcom.ru
# SYNC_USER=u1234567
# SYNC_SSH_KEY=/root/.ssh/primcom_reg
# SYNC_REMOTE_ROOT=/var/www/u1234567/data/www/primcom.ru

# Разрешить удаление большого числа файлов за один раз (по умолчанию защита включена).
# SYNC_ALLOW_MASS_DELETE=1
