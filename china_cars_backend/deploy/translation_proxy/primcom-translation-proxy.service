[Unit]
Description=Primcom Translation Proxy (OpenAI bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/primcom/translation-proxy
EnvironmentFile=/opt/primcom/translation-proxy/.env
ExecStart=/opt/primcom/translation-proxy/.venv/bin/python -m uvicorn translator_proxy:app --host 0.0.0.0 --port 8040
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
