# --- DB ---
POSTGRES_DB=primcom_china_cars
POSTGRES_USER=primcom
POSTGRES_PASSWORD=REDACTED_DATABASE_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://primcom:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/primcom_china_cars

# --- API ---
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=https://primcom.ru,https://www.primcom.ru,http://127.0.0.1:8080

# --- Media ---
MEDIA_DIR=/opt/primcom/china_cars_backend/data/media

# --- OpenAI ---
OPENAI_API_KEY=REDACTED_OPENAI_KEY
OPENAI_TRANSLATION_MODEL=gpt-5-nano
OPENAI_NORMALIZE_MODEL=gpt-5-nano

# --- Scraper limits ---
INITIAL_LOAD_LIMIT=30
DAILY_NEW_LIMIT=75
DAILY_DELETE_LIMIT=0
CHE168_MAX_IMAGES=10
SCRAPER_SOURCE=guazi
SCRAPER_THROTTLE_MS=700
SCRAPER_SKIP_EXISTING=1
SCRAPER_ALLOW_NON_ENGLISH=1
SCRAPER_TRANSLATE_CHINESE=1
