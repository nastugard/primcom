# Postgres (локально через docker-compose)
POSTGRES_DB=primcom_china_cars
POSTGRES_USER=primcom
POSTGRES_PASSWORD=primcom
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# SQLAlchemy async URL
DATABASE_URL=postgresql+asyncpg://primcom:primcom@127.0.0.1:5432/primcom_china_cars

# API
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Media
MEDIA_DIR=./data/media

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-nano
