# Postgres
POSTGRES_DB=primcom_china_cars
POSTGRES_USER=primcom
POSTGRES_PASSWORD=primcom
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://primcom:primcom@127.0.0.1:5432/primcom_china_cars

# API
API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Media
MEDIA_DIR=./data/media

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5-nano
OPENAI_NORMALIZE_MODEL=gpt-5-nano
TRANSLATION_PROXY_URL=
TRANSLATION_PROXY_TOKEN=
TRANSLATION_PROXY_TIMEOUT_MS=15000

# Manager bot ingest
MANAGER_API_KEY=CHANGE_ME_MANAGER_SECRET
SEO_PUBLISH_COMMAND=
SEO_PUBLISH_WORKDIR=.
SEO_PUBLISH_TIMEOUT_SECONDS=90
PRIMCOM_SITE_ROOT=

# Lead notifications (modal form -> Telegram)
LEAD_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
LEAD_RATE_LIMIT_PER_MINUTE=20

# Scraper/ingestion defaults
INITIAL_LOAD_LIMIT=30
DAILY_NEW_LIMIT=75
DAILY_DELETE_LIMIT=0
SCRAPER_ENABLE_DELETE_OLD=0
CHE168_MAX_IMAGES=10
SCRAPER_SOURCE=guazi
SCRAPER_SOURCES=che168,dongchedi,guazi
SCRAPER_THROTTLE_MS=700
SCRAPER_SKIP_EXISTING=1
SCRAPER_ALLOW_NON_ENGLISH=1
SCRAPER_TRANSLATE_CHINESE=1
